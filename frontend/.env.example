# Public URL of the deployed Orbit app, without a trailing slash.
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Create an OAuth App at GitHub Settings -> Developer settings -> OAuth Apps.
# Callback URL: https://your-project.vercel.app/api/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
# Keep this value private and stable across deployments.
SESSION_SECRET=
