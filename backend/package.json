html,
body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #0f172a;
  color: #e2e8f0;
}

* {
  box-sizing: border-box;
}

button,
input,
textarea {
  font: inherit;
}

.page-shell {
  min-height: 100vh;
  padding: 32px;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  background: linear-gradient(180deg, #0f172a 0%, #111827 100%);
}

.panel {
  width: min(1200px, 100%);
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.3);
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 24px 50px rgba(15, 23, 42, 0.4);
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 24px;
}

.eyebrow {
  margin: 0 0 8px;
  color: #38bdf8;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 11px;
  font-weight: 700;
}

h1,
h2 {
  margin: 0;
}

.primary {
  border: none;
  border-radius: 10px;
  background: #38bdf8;
  color: #082f49;
  padding: 12px 18px;
  font-weight: 700;
  cursor: pointer;
}

.primary:disabled {
  opacity: 0.6;
  cursor: wait;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(220px, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #cbd5e1;
  font-size: 14px;
}

.full-width {
  grid-column: 1 / -1;
}

input,
textarea {
  width: 100%;
  border: 1px solid rgba(148, 163, 184, 0.4);
  background: rgba(15, 23, 42, 0.9);
  color: #f8fafc;
  border-radius: 10px;
  padding: 12px 14px;
}

textarea {
  min-height: 350px;
  resize: vertical;
}

.editor-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.editor-wrap,
.preview-wrap {
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 12px;
  padding: 14px;
}

.preview-wrap pre {
  margin: 14px 0 0;
  white-space: pre-wrap;
  word-break: break-word;
  color: #dbeafe;
  min-height: 300px;
  font-family: "SFMono-Regular", Consolas, monospace;
}

.status-box {
  margin-top: 24px;
  border-radius: 10px;
  padding: 14px 16px;
  background: rgba(34, 197, 94, 0.12);
  border: 1px solid rgba(34, 197, 94, 0.4);
  color: #dcfce7;
}

@media (max-width: 768px) {
  .page-shell {
    padding: 16px;
  }

  .form-grid,
  .editor-grid {
    grid-template-columns: 1fr;
  }

  .header-row {
    flex-direction: column;
    align-items: flex-start;
  }
}
