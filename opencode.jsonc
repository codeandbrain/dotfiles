{
  "$schema": "https://opencode.ai/config.json",

  // Orbit uses the free OpenCode model. No paid provider is configured.
  "model": "opencode/big-pickle",
  "default_agent": "orbit-dev",

  // Extra always-on context. AGENTS.md is discovered natively, so it is not repeated here.
  "instructions": ["docs/USER_PERSONA.md", "docs/PRODUCT.md"],

  // Project agents, commands, and skills are discovered from .opencode/.
  // Skills live in .opencode/skills/<name>/SKILL.md; no extra skill path is needed.

  // Ordered rules: the last matching rule wins.
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" }
  ]
}
